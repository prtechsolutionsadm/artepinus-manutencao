# Prisma Postgres: string de conexão "Direct TCP" (começa com postgres://)
# Dashboard em console.prisma.io → seu banco → Connect / API Keys
# Local: rode `npm run db:local` e cole aqui a URL postgres:// exibida
DATABASE_URL="postgres://IDENTIFICADOR:CHAVE@db.prisma.io:5432/postgres?sslmode=require"
# Segredo da sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Notificações push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Protege o cron diário de lembretes (/api/cron/lembretes); a Vercel envia automaticamente
CRON_SECRET=""
