# Neon: use a string "pooled" (host com -pooler) para a aplicação
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Neon: string direta (sem -pooler), usada pelo Prisma para rodar migrations
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Segredo da sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
