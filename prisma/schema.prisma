// Sistema de Manutenção - Artepinus
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN // desenvolvedor do sistema (acesso total, não atribuível pela tela)
  GERENTE // gestão: usuários, setores, relatórios e todas as requisições
  SUPERVISOR // coordena a manutenção: atribui, agenda, cancela, relatórios
  MANUTENTOR // executa: atualiza status e registra o serviço
  OPERADOR // abre requisições e acompanha
  SEM_ACESSO // não usa o módulo de manutenção (só outros módulos)
}

/// Papel no módulo de Produção (Admin e Gerente têm acesso total sem precisar deste campo).
enum PerfilProducao {
  SUPERVISOR // metas, cadastros, edita e exclui qualquer lançamento
  APONTADOR // lança boletins, paradas, ciclos de estufa, toras e estoque
  CONSULTA // só vê painéis e relatórios
}

enum StatusRequisicao {
  ABERTA // recém criada, aguardando análise
  EM_ANALISE // manutenção avaliando
  PLANEJADA // aprovada, aguardando data
  AGENDADA // data definida
  EM_ANDAMENTO // em execução
  AGUARDANDO_PECAS // parada por falta de material
  ADIADA // postergada
  CONCLUIDA // finalizada
  CANCELADA // não será executada
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoManutencao {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
  MELHORIA
}

model Usuario {
  id             String          @id @default(cuid())
  nome           String
  login          String          @unique // nome.sobrenome
  trocarSenha    Boolean         @default(false) // obriga a trocar a senha no próximo acesso
  senhaHash      String
  perfil         Perfil          @default(OPERADOR) // papel no módulo de Manutenção
  perfilProducao PerfilProducao? // papel no módulo de Produção (vazio = sem acesso)
  ativo          Boolean         @default(true)
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt

  requisicoesAbertas    Requisicao[]          @relation("Solicitante")
  requisicoesAtribuidas Requisicao[]          @relation("Responsavel")
  historicos            HistoricoStatus[]
  comentarios           Comentario[]
  notificacaos          Notificacao[]
  inscricaoPushes       InscricaoPush[]
  anexos                Anexo[]
  apontamentos          Apontamento[]
  itensMarcados         ChecklistItem[]
  planosResponsavel     PlanoPreventivo[]     @relation("PlanosResponsavel")
  planosCriados         PlanoPreventivo[]     @relation("PlanosCriados")
  auditorias            Auditoria[]
  boletins              BoletimProducao[]
  ciclosSecagem         CicloSecagem[]
  itensCicloMarcados    ItemChecklistCiclo[]
  cargasToras           CargaToras[]
  levantamentosEstoque  LevantamentoEstoque[]
}

model Setor {
  id           String        @id @default(cuid())
  nome         String        @unique
  equipamentos Equipamento[]
  requisicoes  Requisicao[]
}

model Equipamento {
  id              String            @id @default(cuid())
  codigo          String            @unique // patrimônio / TAG
  nome            String
  descricao       String?
  setorId         String?
  setor           Setor?            @relation(fields: [setorId], references: [id])
  ativo           Boolean           @default(true)
  fabricante      String?
  modelo          String?
  numeroSerie     String?
  requisicoes     Requisicao[]
  planos          PlanoPreventivo[]
  motivosParada   MotivoParada[]
  paradasProducao ParadaProducao[]
  estufa          Estufa?
}

model Requisicao {
  id         Int              @id @default(autoincrement()) // nº da requisição
  titulo     String
  descricao  String
  tipo       TipoManutencao   @default(CORRETIVA)
  prioridade Prioridade       @default(MEDIA)
  status     StatusRequisicao @default(ABERTA)
  local      String?

  solicitanteId String
  solicitante   Usuario      @relation("Solicitante", fields: [solicitanteId], references: [id])
  responsavelId String?
  responsavel   Usuario?     @relation("Responsavel", fields: [responsavelId], references: [id])
  setorId       String?
  setor         Setor?       @relation(fields: [setorId], references: [id])
  equipamentoId String?
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])

  dataAgendada  DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?
  solucao       String? // o que foi feito
  lembreteEm    DateTime? // quando o lembrete do dia agendado foi enviado

  // Equipamento parado por causa do problema (tempo de máquina parada)
  maquinaParada Boolean   @default(false)
  paradaInicio  DateTime?
  paradaFim     DateTime?

  paradasProducao ParadaProducao[] // paradas da produção que originaram esta requisição

  /// Chave gerada no aparelho para requisições abertas sem internet (evita duplicar no reenvio)
  chaveOffline String? @unique

  planoId String? // preventiva gerada automaticamente por este plano
  plano   PlanoPreventivo? @relation(fields: [planoId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico    HistoricoStatus[]
  comentarios  Comentario[]
  anexos       Anexo[]
  apontamentos Apontamento[]
  checklist    ChecklistItem[]

  @@index([status])
  @@index([equipamentoId])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([criadoEm])
}

model HistoricoStatus {
  id             String            @id @default(cuid())
  requisicaoId   Int
  requisicao     Requisicao        @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  statusAnterior StatusRequisicao?
  statusNovo     StatusRequisicao
  observacao     String?
  usuarioId      String
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])
  criadoEm       DateTime          @default(now())

  @@index([requisicaoId])
}

model Comentario {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Usuario    @relation(fields: [autorId], references: [id])
  texto        String
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([usuarioId, lida, criadoEm])
}

/// Aparelho (navegador) inscrito para receber push.
model InscricaoPush {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

enum TipoAnexo {
  PROBLEMA // foto do problema (abertura / comentários)
  SERVICO // foto do serviço realizado
}

/// Foto anexada à requisição. Guardada comprimida no próprio banco (JPEG) e servida
/// só para usuários logados pela rota /api/anexos/[id].
model Anexo {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Usuario    @relation(fields: [autorId], references: [id])
  tipo         TipoAnexo  @default(PROBLEMA)
  mime         String
  dados        Bytes
  miniatura    Bytes
  largura      Int
  altura       Int
  tamanho      Int
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
}

/// Horas trabalhadas por um manutentor numa requisição.
model Apontamento {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  inicio       DateTime
  minutos      Int
  descricao    String?
  criadoEm     DateTime   @default(now())

  @@index([requisicaoId])
  @@index([usuarioId, inicio])
}

model ChecklistModelo {
  id     String                @id @default(cuid())
  nome   String                @unique
  ativo  Boolean               @default(true)
  itens  ChecklistModeloItem[]
  planos PlanoPreventivo[]
}

model ChecklistModeloItem {
  id       String          @id @default(cuid())
  modeloId String
  modelo   ChecklistModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  texto    String
  ordem    Int

  @@index([modeloId, ordem])
}

/// Item de checklist copiado para a requisição (alterar o modelo não muda requisições antigas).
model ChecklistItem {
  id           String     @id @default(cuid())
  requisicaoId Int
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  texto        String
  ordem        Int
  feito        Boolean    @default(false)
  feitoPorId   String?
  feitoPor     Usuario?   @relation(fields: [feitoPorId], references: [id])
  feitoEm      DateTime?

  @@index([requisicaoId, ordem])
}

enum UnidadeFrequencia {
  DIAS
  SEMANAS
  MESES
}

/// Plano de manutenção preventiva: gera requisições agendadas automaticamente.
model PlanoPreventivo {
  id               String            @id @default(cuid())
  equipamentoId    String
  equipamento      Equipamento       @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  titulo           String
  descricao        String?
  intervalo        Int
  unidade          UnidadeFrequencia @default(DIAS)
  proximaData      DateTime // data/hora da próxima execução
  antecedenciaDias Int               @default(3) // gera a requisição N dias antes
  prioridade       Prioridade        @default(MEDIA)
  responsavelId    String?
  responsavel      Usuario?          @relation("PlanosResponsavel", fields: [responsavelId], references: [id])
  checklistId      String?
  checklist        ChecklistModelo?  @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  ativo            Boolean           @default(true)
  criadoPorId      String // aparece como solicitante das requisições geradas
  criadoPor        Usuario           @relation("PlanosCriados", fields: [criadoPorId], references: [id])
  criadoEm         DateTime          @default(now())
  requisicoes      Requisicao[]

  @@index([ativo, proximaData])
}

/// Registro de quem alterou o quê (auditoria).
model Auditoria {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String // ex.: "requisicao.status", "usuario.editar", "login"
  entidade   String // ex.: "Requisicao", "Usuario"
  entidadeId String?
  resumo     String
  detalhes   Json?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
}

// ============================ MÓDULO DE PRODUÇÃO ============================

enum CentroParada {
  MEC // mecânica
  ELE // elétrica
  OPE // operacional
}

/// Catálogo de motivos de parada da linha (códigos da planilha da serraria).
model MotivoParada {
  id            String           @id @default(cuid())
  codigo        Int              @unique
  descricao     String
  centro        CentroParada
  equipamentoId String?
  equipamento   Equipamento?     @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  ativo         Boolean          @default(true)
  paradas       ParadaProducao[]
}

/// Meta do mês (pré-preenche os boletins e serve de referência nos comparativos).
model MetaProducao {
  id             String @id @default(cuid())
  mes            String @unique // "AAAA-MM"
  metaDiariaM3   Float
  horasDia       Float
  rendimentoMeta Float? // m³ produzido ÷ m³ de toras (0–1)
}

/// Boletim diário da serraria (um turno): preenchido pelo encarregado no fim do dia.
model BoletimProducao {
  id               String           @id @default(cuid())
  data             DateTime         @unique @db.Date
  responsavelId    String
  responsavel      Usuario          @relation(fields: [responsavelId], references: [id])
  metaM3           Float
  horasProgramadas Float
  torasQtd         Int?
  torasM3          Float?
  diametroMedio    Float? // cm
  comprimentoMedio Float? // m
  observacoes      String?
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt
  itens            ItemProducao[]
  paradas          ParadaProducao[]
}

enum TipoProduto {
  BOM
  APROVEITAMENTO
  REFUGO
}

enum Mercado {
  EXTERNO
  INTERNO
}

/// Produção por bitola (espessura × largura × comprimento em mm).
model ItemProducao {
  id          String          @id @default(cuid())
  boletimId   String
  boletim     BoletimProducao @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  tipo        TipoProduto
  mercado     Mercado         @default(EXTERNO)
  espessura   Int
  largura     Int
  comprimento Int
  pecas       Int
  m3          Float

  @@index([boletimId])
}

model ParadaProducao {
  id            String          @id @default(cuid())
  boletimId     String
  boletim       BoletimProducao @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  motivoId      String?
  motivo        MotivoParada?   @relation(fields: [motivoId], references: [id], onDelete: SetNull)
  equipamentoId String?
  equipamento   Equipamento?    @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  centro        CentroParada
  ocorrencias   Int             @default(1)
  minutos       Float
  descricao     String?
  requisicaoId  Int?
  requisicao    Requisicao?     @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)

  @@index([boletimId])
  @@index([motivoId])
}

// ---------- Estufas ----------

model Estufa {
  id            String         @id @default(cuid())
  numero        Int            @unique
  nome          String
  capacidadeM3  Float?
  equipamentoId String?        @unique // a mesma estufa no módulo de manutenção
  equipamento   Equipamento?   @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  ativo         Boolean        @default(true)
  ciclos        CicloSecagem[]
}

enum StatusCiclo {
  EM_SECAGEM
  CONCLUIDO
  CANCELADO
}

model CicloSecagem {
  id             String               @id @default(cuid())
  estufaId       String
  estufa         Estufa               @relation(fields: [estufaId], references: [id])
  numero         Int? // nº do ciclo (controle da estufa)
  status         StatusCiclo          @default(EM_SECAGEM)
  entrada        DateTime
  previsaoSaida  DateTime?
  saida          DateTime?
  umidadeInicial Float?
  umidadeFinal   Float?
  plantao        String? // responsáveis pelo plantão
  proximaCarga   String?
  observacoes    String?
  responsavelId  String
  responsavel    Usuario              @relation(fields: [responsavelId], references: [id])
  criadoEm       DateTime             @default(now())
  cargas         CargaCiclo[]
  checklist      ItemChecklistCiclo[]

  @@index([estufaId, entrada])
  @@index([status])
}

/// Madeira dentro da estufa: uma linha por bitola/comprimento.
model CargaCiclo {
  id          String       @id @default(cuid())
  cicloId     String
  ciclo       CicloSecagem @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  espessura   Int // mm
  largura     String // ex.: "85-100-125" ou "Mista 3, 4 e 5"
  comprimento Float // m
  grades      Int
  m3          Float

  @@index([cicloId])
}

model ItemChecklistCiclo {
  id           String       @id @default(cuid())
  cicloId      String
  ciclo        CicloSecagem @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  secao        String?
  texto        String
  ordem        Int
  conforme     Boolean? // null = não conferido
  observacao   String?
  marcadoPorId String?
  marcadoPor   Usuario?     @relation(fields: [marcadoPorId], references: [id])
  marcadoEm    DateTime?

  @@index([cicloId, ordem])
}

// ---------- Recebimento de toras ----------

model CargaToras {
  id               String           @id @default(cuid())
  data             DateTime
  origem           String
  talhao           String?
  motorista        String?
  placa            String?
  comprimentoMedio Float? // m — usado no volume estimado
  observacoes      String?
  responsavelId    String
  responsavel      Usuario          @relation(fields: [responsavelId], references: [id])
  criadoEm         DateTime         @default(now())
  itens            ItemCargaToras[]

  @@index([data])
}

model ItemCargaToras {
  id         String     @id @default(cuid())
  cargaId    String
  carga      CargaToras @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  diametro   Int // cm
  quantidade Int

  @@index([cargaId])
}

// ---------- Estoque de madeira (levantamentos) ----------

enum TipoEstoque {
  VERDE
  EMPACOTADA
}

model LevantamentoEstoque {
  id            String        @id @default(cuid())
  data          DateTime
  tipo          TipoEstoque
  observacoes   String?
  responsavelId String
  responsavel   Usuario       @relation(fields: [responsavelId], references: [id])
  criadoEm      DateTime      @default(now())
  itens         ItemEstoque[]

  @@index([tipo, data])
}

model ItemEstoque {
  id             String              @id @default(cuid())
  levantamentoId String
  levantamento   LevantamentoEstoque @relation(fields: [levantamentoId], references: [id], onDelete: Cascade)
  espessura      Int // mm
  largura        String
  comprimento    Float // m
  grades         Int?
  pacotes        Int?
  m3             Float

  @@index([levantamentoId])
}
